#version 460
#extension GL_EXT_ray_tracing : require

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(location = 0) rayPayloadEXT vec4 payload;

const uint kRayFlags = 0x16u;
const uint kCullMask = 0x7fu;
const uint kSbtOffset = 3u;
const uint kSbtStride = 5u;
const uint kMissIndex = 2u;

void main()
{
   vec2 pixel = vec2(gl_LaunchIDEXT.xy) + vec2(0.5);
   vec2 extent = vec2(gl_LaunchSizeEXT.xy);
   vec2 uv = pixel / extent;
   float aspect = extent.x / extent.y;

   vec3 origin = vec3(0.0, 0.0, 2.6);
   vec3 direction =
      normalize(vec3((2.0 * uv.x - 1.0) * aspect, 1.0 - 2.0 * uv.y, -1.65));

   payload = vec4(uv, 0.25, 1.0);
   traceRayEXT(topLevelAS, kRayFlags, kCullMask, kSbtOffset, kSbtStride,
               kMissIndex, origin, 0.125, direction, 64.0, 0);
}
